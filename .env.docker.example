# ============================================================
# Corgly — Exemplo de .env.docker (sem valores reais)
# Copie para .env.docker e preencha os valores
# Este arquivo PODE ser commitado
# ============================================================

# ── Ambiente ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1234

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=corgly_dev
MYSQL_USER=corgly
MYSQL_PASSWORD=
DATABASE_URL=mysql://corgly:PASSWORD@db:3306/corgly_dev

# ── JWT / Segredos (mínimo 32 chars) ─────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
CRON_SECRET=
HOCUSPOCUS_JWT_SECRET=
ENCRYPTION_KEY=

# ── MFA admin (bypass de desenvolvimento) ─────────────────────
# Somente NODE_ENV=development. Prefira `.env.development.local`; com valor
# true fora de development o boot e recusado (src/lib/env.ts).
# ADMIN_MFA_DEV_BYPASS=false

# ── Stripe (chaves de teste para dev) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM=Corgly <no-reply@corgly.app>

# ── WebRTC TURN (opcional) ────────────────────────────────────
TURN_SERVER_URL=
TURN_SERVER_SECRET=
