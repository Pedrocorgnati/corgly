model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  /// Cadencia legada (aulas por semana, 1..5). Continua sendo a fonte de
  /// precificacao e de concessao de creditos das assinaturas antigas, criadas
  /// antes do eixo mensal. NAO remover: ha assinaturas vivas so com este campo.
  weeklyFrequency      Int
  /// Eixo canonico novo: volume mensal contratado (10 ou 20 aulas por mes),
  /// espelhando os planos da landing. Null = assinatura legada, precificada e
  /// creditada por `weeklyFrequency`. Quando presente, vence o eixo legado
  /// tanto no preco quanto nos creditos mensais concedidos.
  monthlyLessons       Int?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model SessionDocument {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  yjsState          Bytes?   @db.LongBlob
  plainTextSnapshot String?  @db.LongText
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id])

  @@map("session_documents")
}

/// Snapshot versionado e imutavel do caderno pos-aula (T-019, PRD §12.3).
///
/// Cada linha congela o estado do `SessionDocument` no momento da captura,
/// guardando payload suficiente para restore (texto + estado Yjs binario) e
/// metadata de auditoria. A versao e monotonica por sessao e o `contentHash`
/// torna o POST idempotente: capturas sucessivas sem mudanca no documento
/// reaproveitam o ultimo snapshot ao inves de criar uma nova versao.
model SessionNoteSnapshot {
  id                String   @id @default(uuid())
  sessionId         String
  version           Int // monotonica por sessao, 1-based
  contentHash       String // sha256 do payload, chave de idempotencia por sessao
  plainTextSnapshot String?  @db.LongText
  yjsState          Bytes?   @db.LongBlob
  createdById       String // autor da captura (FK logica para User, validada na app)
  metadata          Json? // { plainTextLength, yjsByteLength, documentUpdatedAt }
  createdAt         DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, version]) // UNIQUE_snapshot_session_version - idempotencia por versao
  @@index([sessionId, createdAt]) // ordenacao temporal das capturas
  @@map("session_note_snapshots")
}

enum ContentStatus {
