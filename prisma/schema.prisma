model CookieConsent {
  id                  String        @id @default(uuid())
  userId              String?
  sessionFingerprint  String?
  essentialAccepted   Boolean       @default(true)
  analyticsAccepted   Boolean       @default(false)
  marketingAccepted   Boolean       @default(false)
  consentVersion      String        @default("1.0") @db.VarChar(20)
  legalTextVersion    String        @default("1.0") @db.VarChar(20)
  source              ConsentSource @default(COOKIE_BANNER)
  acceptedAt          DateTime      @default(now())
  lastPreferenceSetAt DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user    User?                  @relation(fields: [userId], references: [id])
  history CookieConsentHistory[]

  @@unique([userId])
  @@unique([sessionFingerprint])
  @@index([consentVersion])
  @@map("cookie_consents")
}

enum ConsentSource {
  COOKIE_BANNER
  ACCOUNT_SETTINGS
  CHECKOUT
  ADMIN
  IMPORT
}

model CookieConsentHistory {
  id                 String        @id @default(uuid())
  consentId          String?
  userId             String?
  sessionFingerprint String?
  essentialAccepted  Boolean       @default(true)
  analyticsAccepted  Boolean       @default(false)
  marketingAccepted  Boolean       @default(false)
  consentVersion     String        @db.VarChar(20)
  legalTextVersion   String        @db.VarChar(20)
  source             ConsentSource
  changedAt          DateTime      @default(now())
  metadata           Json?

  consent CookieConsent? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([consentId, changedAt])
  @@index([userId, changedAt])
  @@index([sessionFingerprint, changedAt])
