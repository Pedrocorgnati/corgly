model User {
  id                          String            @id @default(uuid())
  email                       String            @unique
  passwordHash                String
  name                        String
  role                        UserRole          @default(STUDENT)
  country                     String?
  timezone                    String
  emailConfirmed              Boolean           @default(false)
  emailConfirmToken           String?
  emailConfirmExpires         DateTime?
  resetPasswordToken          String?
  resetPasswordExpires        DateTime?
  maxFutureSessions           Int               @default(5)
  isFirstPurchase             Boolean           @default(true)
  preferredLanguage           SupportedLanguage @default(EN_US)
  preferredCurrency           CurrencyCode?     @map("preferred_currency")
  onboardingCompletedAt       DateTime?
  termsAcceptedAt             DateTime?
  termsVersion                String            @default("1.0") @db.VarChar(10)
  marketingOptIn              Boolean           @default(false)
  deletionRequestedAt         DateTime?
  tokenVersion                Int               @default(0)
  mfaEnabled                  Boolean           @default(false)
  mfaEnabledAt                DateTime?
  lastLoginAt                 DateTime?
  deletionCancellationToken   String?
  deletionCancellationExpires DateTime?
  stripeCustomerId            String?           @unique
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  creditBatches           CreditBatch[]
  sessions                Session[]
  payments                Payment[]
  refundRequests          RefundRequest[]
  subscriptions           Subscription[]
  recurringPatterns       RecurringPattern[]
  cookieConsents          CookieConsent[]
  cookieConsentHistory    CookieConsentHistory[]
  feedbacksAsAdmin        Feedback[]                  @relation("FeedbackAdmin")
  supportTickets          SupportTicket[]             @relation("SupportTicketUser")
  supportMessages         SupportMessage[]            @relation("SupportMessageAuthor")
  referrals               Referral[]                  @relation("ReferralReferrer")
  referralInvitesReceived ReferralInvite[]            @relation("ReferralInvitedUser")
  referralCredits         ReferralCredit[]            @relation("ReferralCreditBeneficiary")
  featureFlagOverrides    FeatureFlagOverride[]       @relation("FeatureFlagOverrideUser")
  dataRequests            DataRequest[]               @relation("DataRequestUser")
  assets                  Asset[]                     @relation("AssetOwner")
  emailDeliveries         EmailDelivery[]             @relation("EmailDeliveryUser")
  createdJobs             Job[]                       @relation("JobCreatedBy")
  termAcceptances         TermAcceptance[]            @relation("TermAcceptanceUser")
  onboardingProfile       OnboardingProfile?
  mfa                     UserMfa?
  sessionHealthEvents     SessionHealth[]             @relation("SessionHealthParticipant")
  impersonationsAsAdmin   AdminImpersonationSession[] @relation("AdminImpersonationAdmin")
  impersonationsAsStudent AdminImpersonationSession[] @relation("AdminImpersonationStudent")
  impersonationsEnded     AdminImpersonationSession[] @relation("AdminImpersonationEndedBy")
  magicLinkTokens         MagicLinkToken[]            @relation("MagicLinkTokenUser")

  @@index([role])
  @@index([emailConfirmToken])
  @@index([resetPasswordToken])
  @@index([deletionRequestedAt])
  @@map("users")
}

/// T-045: token de magic-link (login sem senha).
/// Dedicado (nao reusa o pattern single-field do User) para suportar multiplos
/// tokens pendentes, marcacao de uso unico (consumedAt) e anti-replay.
/// Armazena apenas o hash SHA-256 do token; o token bruto so existe no link enviado.
model MagicLinkToken {
  id           String    @id @default(uuid())
  userId       String
  /// SHA-256 hex do token bruto. Lookup sempre por hash (nunca pelo token cru).
  tokenHash    String    @unique
  expiresAt    DateTime
  /// Marcado atomicamente na primeira consumacao. Nao-nulo => ja usado (rejeita replay).
  consumedAt   DateTime?
  /// IP do solicitante (auditoria / rate-limit forense). Pode ser 'unknown'.
  requesterIp  String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  user User @relation("MagicLinkTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model CreditBatch {
  id                    String     @id @default(uuid())
  userId                String
  type                  CreditType
  totalCredits          Int
  usedCredits           Int        @default(0)
  expiresAt             DateTime?
  stripePaymentIntentId String?    @unique
  reason                String?    @db.VarChar(500)
  lastExpiryEmailSent   DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]
  payment  Payment?

  @@index([userId, expiresAt])
  @@map("credit_batches")
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  startAt   DateTime @unique // UNIQUE_slot_startAt - um slot por horário
  endAt     DateTime
  isBlocked Boolean  @default(false)
  version   Int      @default(0) // lock otimista CAS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@index([startAt, isBlocked], name: "IDX_availability_startAt_isBlocked")
  @@map("availability_slots")
}

model RecurringPattern {
  id        String   @id @default(uuid())
  studentId String
  dayOfWeek Int
  startTime String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User      @relation(fields: [studentId], references: [id])
  sessions Session[]

  @@index([studentId, isActive])
  @@map("recurring_patterns")
}

model Session {
  id                      String        @id @default(uuid())
  studentId               String
  availabilitySlotId      String        @unique // UNIQUE_session_slot - um slot por sessão
  startAt                 DateTime
  endAt                   DateTime
  status                  SessionStatus @default(SCHEDULED)
  creditBatchId           String?
  isRecurring             Boolean       @default(false)
  recurringPatternId      String?
  cancelledAt             DateTime?
  cancelledBy             UserRole?
  completedAt             DateTime?
  interruptedAt           DateTime?
  extendedBy              Int?
  reminderSentAt          Json? // { "24h": ISO, "1h": ISO } - idempotência do cron
  rescheduleRequestSlotId String? // slot proposto em RESCHEDULE_PENDING
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  student          User              @relation(fields: [studentId], references: [id])
  availabilitySlot AvailabilitySlot  @relation(fields: [availabilitySlotId], references: [id])
  creditBatch      CreditBatch?      @relation(fields: [creditBatchId], references: [id])
  recurringPattern RecurringPattern? @relation(fields: [recurringPatternId], references: [id])
  feedback         Feedback?
  document         SessionDocument?
  noteSnapshots    SessionNoteSnapshot[]
  supportTickets   SupportTicket[]
  assets           Asset[]
  healthEvents     SessionHealth[]

  @@index([studentId, status])
  @@index([startAt])
  @@index([status])
  @@map("sessions")
}

model SessionHealth {
  id                  String                 @id @default(uuid())
  sessionId           String
  participantId       String?
  participantRole     UserRole
  eventType           SessionHealthEventType @default(METRIC_SNAPSHOT)
  occurredAt          DateTime               @default(now())
  latencyMs           Int?
  jitterMs            Int?
  packetLossPercent   Decimal?               @db.Decimal(5, 2)
  webrtcState         WebRtcConnectionState
  reconnectAttempt    Int                    @default(0)
  reconnectReason     String?                @db.VarChar(255)
  reconnectSuccessful Boolean?
  metadata            Json?
  createdAt           DateTime               @default(now())

  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant User?   @relation("SessionHealthParticipant", fields: [participantId], references: [id], onDelete: SetNull)

  @@index([sessionId, occurredAt])
  @@index([sessionId, participantRole, occurredAt])
  @@index([participantId, occurredAt])
  @@index([webrtcState, occurredAt])
  @@map("session_health")
}

model Job {
  id                String    @id @default(uuid())
  type              JobType
  queueName         String    @default("default") @db.VarChar(80)
  payload           Json
  status            JobStatus @default(QUEUED)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  priority          Int       @default(0)
  scheduledAt       DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  lockedAt          DateTime?
  lockedBy          String?   @db.VarChar(120)
  finalErrorCode    String?   @db.VarChar(80)
  finalErrorMessage String?   @db.Text
  finalErrorAt      DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy User? @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([type, status])
  @@index([queueName, status, priority, scheduledAt])
  @@index([createdById, createdAt])
  @@map("jobs")
}

/// Invariante de sessao ativa (AC2/AC3) enforced via CHECK
/// `admin_impersonation_sessions_active_state_chk` na migration
/// 20260527000012_admin_impersonation_active_coupling: sessao aberta (endedAt
/// NULL) => activeAdminKey = adminId E activeStudentKey = studentId E endReason/
/// endedById NULL; sessao encerrada => active keys NULL E endReason NOT NULL.
/// Como a linha aberta carrega activeAdminKey = adminId, duas sessoes ativas do
/// mesmo admin colidiriam na UNIQUE -> no maximo uma ativa por admin (idem por
/// student). MySQL nao tem indice parcial; Prisma 5 nao expressa CHECK no schema;
/// ver a migration. endedById nao e exigido (FK endedBy usa onDelete SetNull).
model AdminImpersonationSession {
  id               String                       @id @default(uuid())
  adminId          String
  studentId        String
  startedAt        DateTime                     @default(now())
  expiresAt        DateTime
  endedAt          DateTime?
  endedById        String?
  endReason        AdminImpersonationEndReason?
  reason           String                       @db.VarChar(500)
  ipAddress        String                       @db.VarChar(45)
  userAgent        String                       @db.VarChar(512)
  activeAdminKey   String?                      @unique @db.VarChar(191)
  activeStudentKey String?                      @unique @db.VarChar(191)
  metadata         Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  admin   User  @relation("AdminImpersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  student User  @relation("AdminImpersonationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  endedBy User? @relation("AdminImpersonationEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([adminId, startedAt])
  @@index([studentId, startedAt])
  @@index([expiresAt])
  @@index([endedAt])
  @@map("admin_impersonation_sessions")
}

