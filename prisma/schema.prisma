}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("audit_logs")
}

/// MFA TOTP por usuario (obrigatorio para admin — T-043).
/// O segredo TOTP e cifrado em repouso (AES-256-GCM via ENCRYPTION_KEY).
model UserMfa {
  id              String    @id @default(uuid())
  userId          String    @unique
  /// Segredo TOTP cifrado: formato ivHex:tagHex:ctHex.
  secretEnc       String    @db.Text
  /// PENDING ate a primeira verificacao confirmar; depois ACTIVE.
  status          String    @default("PENDING")
  confirmedAt     DateTime?
  lastVerifiedAt  DateTime?
  /// Ultimo time-step TOTP consumido — guarda anti-replay.
  lastUsedCounter BigInt?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@map("user_mfa")
}

/// Codigos de recuperacao MFA de uso unico (armazenados apenas como hash bcrypt).
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  mfaId     String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  mfa UserMfa @relation(fields: [mfaId], references: [id], onDelete: Cascade)

  @@index([mfaId])
  @@map("mfa_recovery_codes")
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAuthorRole {
  STUDENT
  ADMIN
  SYSTEM
}

model SupportTicket {
  id         String                @id @default(uuid())
  subject    String                @db.VarChar(200)
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(NORMAL)
  userId     String?
  sessionId  String?
  resolvedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  user     User?            @relation("SupportTicketUser", fields: [userId], references: [id])
  session  Session?         @relation(fields: [sessionId], references: [id])
  messages SupportMessage[]

  @@index([status, priority])
  @@index([userId])
  @@index([sessionId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String            @id @default(uuid())
  ticketId   String
  authorId   String?
  authorRole SupportAuthorRole
  body       String            @db.Text
  isInternal Boolean           @default(false)
  createdAt  DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("support_messages")
}

enum ReferralStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum ReferralInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ReferralCreditStatus {
  PENDING
  GRANTED
  REVOKED
}

model Referral {
  id         String         @id @default(uuid())
  code       String         @unique // UNIQUE_referral_code - impede código duplicado
  referrerId String
  status     ReferralStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  referrer User             @relation("ReferralReferrer", fields: [referrerId], references: [id])
  invites  ReferralInvite[]
  credits  ReferralCredit[]

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralInvite {
  id            String               @id @default(uuid())
  referralId    String
  invitedEmail  String
  invitedUserId String?
  status        ReferralInviteStatus @default(PENDING)
  acceptedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  referral    Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  invitedUser User?           @relation("ReferralInvitedUser", fields: [invitedUserId], references: [id])
  credit      ReferralCredit?

  @@unique([referralId, invitedEmail]) // impede convite duplicado do mesmo email no mesmo programa
  @@index([invitedUserId])
  @@index([status])
  @@map("referral_invites")
}

model ReferralCredit {
  id                String               @id @default(uuid())
  referralId        String
  inviteId          String               @unique // UNIQUE_referral_credit_invite - impede dupla concessão de crédito por convite
  beneficiaryUserId String
  creditBatchId     String?              @unique
  amount            Int
  status            ReferralCreditStatus @default(PENDING)
  grantedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  referral    Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  invite      ReferralInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  beneficiary User           @relation("ReferralCreditBeneficiary", fields: [beneficiaryUserId], references: [id])

  @@index([beneficiaryUserId])
  @@index([status])
  @@map("referral_credits")
}

// ─── Feature flags (§12.4.2) - rollout de sala (realtime), billing portal e onboarding v2 ──

enum FeatureFlagScope {
  GLOBAL // aplica a todos os usuários
  ROLE // aplica a um UserRole específico (targetRole)
  COHORT // aplica a um coorte nomeado (targetCohort)
}

enum FeatureFlagAuditAction {
  CREATED
  ENABLED
  DISABLED
  ROLLOUT_CHANGED
  SCOPE_CHANGED
  OVERRIDE_SET
  OVERRIDE_CLEARED
}

model FeatureFlag {
  id                String           @id @default(uuid())
  key               String           @unique // UNIQUE_feature_flag_key - identificador estável usado no código
  description       String           @db.VarChar(280)
  enabled           Boolean          @default(false)
  rolloutPercentage Int              @default(0) // 0..100 - gating determinístico por hash(key+userId)
  scope             FeatureFlagScope @default(GLOBAL)
  targetRole        UserRole? // preenchido quando scope = ROLE
  targetCohort      String? // preenchido quando scope = COHORT
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  overrides FeatureFlagOverride[]
  audits    FeatureFlagAudit[]

  @@index([enabled])
  @@index([scope])
  @@map("feature_flags")
}

model FeatureFlagOverride {
  id        String   @id @default(uuid())
  flagId    String
  userId    String
  enabled   Boolean // força on/off para este usuário, ignorando rollout
  reason    String?  @db.VarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  user User        @relation("FeatureFlagOverrideUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flagId, userId]) // impede override duplicado do mesmo usuário para a mesma flag
  @@index([userId])
  @@map("feature_flag_overrides")
}

model FeatureFlagAudit {
  id          String                 @id @default(uuid())
  flagId      String
  actorId     String? // admin que efetuou a mudança (null = sistema/seed)
  action      FeatureFlagAuditAction
  fromEnabled Boolean?
  toEnabled   Boolean?
  metadata    Json? // detalhe da mudança (rollout antigo/novo, escopo, etc.)
  createdAt   DateTime               @default(now())

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt])
  @@map("feature_flag_audits")
}

// ─── Leads (§12.4.3) - captação pública: landing, método e contato ──────────

enum LeadOrigin {
  LANDING // formulário da landing page
  METHOD // página do método
  CONTACT // formulário de contato
}

enum LeadStatus {
  NEW // recém-captado, não triado
  CONTACTED // já houve retorno ao lead
  CONVERTED // virou aluno/cliente
  SPAM // marcado como abuso
  ARCHIVED // arquivado sem conversão
}

model Lead {
  id           String            @id @default(uuid())
  origin       LeadOrigin
  email        String
  name         String?           @db.VarChar(160)
  message      String?           @db.Text
  locale       SupportedLanguage @default(PT_BR)
  consentGiven Boolean           @default(false) // aceite explícito de contato/privacidade
  consentAt    DateTime? // momento do aceite (null = sem consentimento registrado)
  status       LeadStatus        @default(NEW)

  // metadados anti-abuso - nunca expostos no schema público de entrada
  ipHash      String? @db.VarChar(64) // SHA-256 do IP de origem (nunca o IP cru)
  userAgent   String? @db.VarChar(400)
  honeypotHit Boolean @default(false) // campo isca preenchido => provável bot
  spamScore   Int     @default(0) // heurística 0..100; >= threshold => SPAM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // detecção de duplicidade abusiva por email/origem em janela curta (janela aplicada na aplicação)
  @@index([email, origin, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ─── Data Subject Requests (§12.4.1 / §12.4.4) - exportação, correção, portabilidade e exclusão ──

enum DataRequestType {
  EXPORT
  RECTIFICATION
  PORTABILITY
  DELETION
}

enum DataRequestChannel {
  WEB_PORTAL
  EMAIL
  SUPPORT
  ADMIN
}

enum DataRequestStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING
  IN_PROGRESS
  EXPORT_READY
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DataRequestJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model DataRequest {
  id                       String             @id @default(uuid())
  referenceCode            String             @unique @db.VarChar(40)
  userId                   String?
  type                     DataRequestType
  channel                  DataRequestChannel
  requesterEmail           String             @db.VarChar(254)
  requesterEmailVerifiedAt DateTime?
  status                   DataRequestStatus  @default(PENDING_EMAIL_VERIFICATION)
  signedArchiveUrl         String?            @db.VarChar(1000)
  signedArchiveSha256      String?            @db.VarChar(64)
  signedArchiveExpiresAt   DateTime?
  slaDueAt                 DateTime
  correctionPayload        Json?
  metadata                 Json?
  completedAt              DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?            @db.Text
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User?           @relation("DataRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  job  DataRequestJob?

  @@index([userId, status])
  @@index([requesterEmail, status])
  @@index([status, slaDueAt])
  @@index([type, status])
  @@map("data_requests")
}

model DataRequestJob {
  id            String               @id @default(uuid())
  dataRequestId String               @unique
  queueName     String               @default("privacy.data-request") @db.VarChar(80)
  status        DataRequestJobStatus @default(QUEUED)
  attempts      Int                  @default(0)
  scheduledAt   DateTime             @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  errorCode     String?              @db.VarChar(80)
  errorMessage  String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  dataRequest DataRequest @relation(fields: [dataRequestId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@map("data_request_jobs")
}

// ─── Assets, transcripts e captions (§12.4.2 / §12.4.4) ─────────────────────

enum AssetType {
  VIDEO
  AUDIO
  DOCUMENT
  IMAGE
  OTHER
}

enum AssetStorageProvider {
  LOCAL
  S3
  R2
  VERCEL_BLOB
  EXTERNAL
}

enum AssetProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum CaptionFormat {
  VTT
  SRT
  TXT
}

enum CaptionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Asset {
  id               String                @id @default(uuid())
  ownerId          String?
  sessionId        String?
  contentId        String?
  type             AssetType
  storageProvider  AssetStorageProvider  @default(LOCAL)
  storageKey       String                @unique @db.VarChar(500)
  originalFilename String                @db.VarChar(255)
  mimeType         String                @db.VarChar(120)
  fileSizeBytes    BigInt
  checksumSha256   String?               @db.VarChar(64)
  publicUrl        String?               @db.VarChar(1000)
  durationSeconds  Int?
  language         SupportedLanguage?
  processingStatus AssetProcessingStatus @default(PENDING)
  processingError  String?               @db.Text
  metadata         Json?
  uploadedAt       DateTime              @default(now())
  processedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  owner       User?        @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  content     Content?     @relation(fields: [contentId], references: [id], onDelete: SetNull)
  transcripts Transcript[]
  captions    Caption[]

  @@index([ownerId, processingStatus])
  @@index([sessionId, processingStatus])
  @@index([contentId, processingStatus])
  @@index([type, processingStatus])
  @@index([language])
  @@index([createdAt])
  @@map("assets")
}

model Transcript {
  id             String            @id @default(uuid())
  assetId        String
  language       SupportedLanguage
  status         TranscriptStatus  @default(PENDING)
  provider       String?           @db.VarChar(80)
  rawText        String            @db.LongText
  normalizedText String?           @db.LongText
  confidence     Float?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?           @db.Text
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  captions Caption[]

  @@unique([assetId, language])
  @@index([status, language])
  @@index([assetId, status])
  @@map("transcripts")
}

model Caption {
  id           String            @id @default(uuid())
  assetId      String
  transcriptId String?
  language     SupportedLanguage
  format       CaptionFormat
  status       CaptionStatus     @default(PENDING)
  storageKey   String?           @db.VarChar(500)
  publicUrl    String?           @db.VarChar(1000)
  content      String?           @db.LongText
  generatedAt  DateTime?
  errorMessage String?           @db.Text
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transcript Transcript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  @@unique([assetId, language, format])
  @@index([assetId, status])
  @@index([language, status])
  @@index([transcriptId])
  @@map("captions")
}

// ─── Email templates e deliveries (§12.4.4 / AD-16 / AD-33 / AD-34) ────────

model EmailTemplate {
  id          String              @id @default(uuid())
  type        EmailType
  locale      SupportedLanguage
  channel     EmailChannel        @default(EMAIL)
  version     Int                 @default(1)
  status      EmailTemplateStatus @default(DRAFT)
  subject     String              @db.VarChar(180)
  preheader   String?             @db.VarChar(180)
  htmlBody    String              @db.LongText
  textBody    String?             @db.LongText
  variables   Json?
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  deliveries EmailDelivery[]

  @@unique([type, locale, channel, version])
  @@index([type, locale, status])
  @@index([status, updatedAt])
  @@map("email_templates")
}

model EmailDelivery {
  id                String              @id @default(uuid())
  templateId        String?
  type              EmailType
  locale            SupportedLanguage
  channel           EmailChannel        @default(EMAIL)
  toEmail           String              @db.VarChar(254)
  userId            String?
  provider          String?             @db.VarChar(80)
  providerMessageId String?             @unique @db.VarChar(191)
  status            EmailDeliveryStatus @default(QUEUED)
  subject           String              @db.VarChar(180)
  renderedHtml      String?             @db.LongText
  renderedText      String?             @db.LongText
  data              Json?
  errorCode         String?             @db.VarChar(80)
  errorMessage      String?             @db.Text
  attempts          Int                 @default(0)
  queuedAt          DateTime            @default(now())
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user     User?          @relation("EmailDeliveryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([templateId, status])
  @@index([userId, status])
  @@index([type, locale, status])
  @@index([status, queuedAt])
  @@index([toEmail])
  @@map("email_deliveries")
}

// ─── FX multi-moeda (§12.4.2 / §12.4.4) ───────────────────────────────────

model FxRate {
  id             String           @id @default(uuid())
  baseCurrency   CurrencyCode     @default(USD)
  quoteCurrency  CurrencyCode
  rate           Decimal          @db.Decimal(18, 8)
  source         FxRateSource
  roundingPolicy FxRoundingPolicy @default(HALF_UP)
  validFrom      DateTime
  validUntil     DateTime?
  collectedAt    DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([baseCurrency, quoteCurrency, source, validFrom])
  @@index([baseCurrency, quoteCurrency, validFrom, validUntil])
  @@index([source, collectedAt])
  @@map("fx_rates")
}

// ─── Documentos legais versionados (§12.4.4 / GL-19) ────────────────────────

model LegalDoc {
  id                 String            @id @default(uuid())
  type               LegalDocType
  locale             SupportedLanguage @default(PT_BR)
  version            String            @db.VarChar(40)
  status             LegalDocStatus    @default(DRAFT)
  title              String            @db.VarChar(180)
  slug               String            @db.VarChar(200)
  bodyMarkdown       String            @db.LongText
  contentHashSha256  String            @db.VarChar(64)
  effectiveAt        DateTime
  publishedAt        DateTime?
  archivedAt         DateTime?
  requiresAcceptance Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  acceptances TermAcceptance[]

  @@unique([type, locale, version])
  @@unique([locale, slug, version])
  @@index([type, locale, status, effectiveAt])
  @@index([contentHashSha256])
  @@map("legal_docs")
}

model TermAcceptance {
  id         String                @id @default(uuid())
  userId     String
  legalDocId String
  type       LegalDocType
  version    String                @db.VarChar(40)
  acceptedAt DateTime              @default(now())
  source     LegalAcceptanceSource @default(LOGIN_BLOCKER)
  ipHash     String?               @db.VarChar(64)
  userAgent  String?               @db.VarChar(400)
  metadata   Json?
  createdAt  DateTime              @default(now())

  user     User     @relation("TermAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)
  legalDoc LegalDoc @relation(fields: [legalDocId], references: [id])

  @@unique([userId, legalDocId])
  @@unique([userId, type, version])
  @@index([userId, acceptedAt])
  @@index([type, version])
  @@map("term_acceptances")
}

// ─── Onboarding profile (§12.4.4 / ON-03 / ON-04 / ON-08) ──────────────────

model OnboardingProfile {
  id                String                   @id @default(uuid())
  userId            String                   @unique
  currentLevel      LanguageProficiencyLevel @default(BEGINNER)
  preferredLanguage SupportedLanguage        @default(EN_US)
  timezone          String                   @db.VarChar(100)
  currentStep       OnboardingStep           @default(WELCOME)
  preferences       Json?
  notes             String?                  @db.Text
  completedAt       DateTime?
  skippedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals LanguageGoal[]

  @@index([currentStep, updatedAt])
  @@index([preferredLanguage])
  @@index([timezone])
  @@map("onboarding_profiles")
}

model LanguageGoal {
  id          String           @id @default(uuid())
  profileId   String
  type        LanguageGoalType
  label       String           @db.VarChar(120)
  description String?          @db.Text
  priority    Int              @default(0)
  targetDate  DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  profile OnboardingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@index([profileId, priority])
  @@index([type])
  @@map("language_goals")
}
