# ============================================
# CORGLY — VARIAVEIS DE AMBIENTE (EXEMPLO)
# ============================================
# Copie este arquivo para .env e preencha os valores

# AMBIENTE
NODE_ENV=development
PORT=3000

# APLICACAO
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:8000

# DATABASE
# Serverless (Vercel): adicione ?connection_limit=5&pool_timeout=10
# Self-hosted (PM2/Docker): adicione ?connection_limit=20&pool_timeout=30
DATABASE_URL=

# REDIS (Upstash) — obrigatório para rate limiting distribuído e signaling
# Crie uma instância em https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SEGURANCA (Auto-gerados)
JWT_SECRET=
JWT_EXPIRES_IN=7d
CRON_SECRET=
HOCUSPOCUS_JWT_SECRET=
SESSION_ENTRY_TOKEN_SECRET=
ENCRYPTION_KEY=

# MFA ADMIN (bypass de desenvolvimento)
# Desliga o gate de MFA das rotas /admin/* SOMENTE com NODE_ENV=development.
# Defina APENAS em `.env.development.local` (lido so por `next dev`), nunca aqui
# nem em `.env`: `next build`/`next start` rodam com NODE_ENV=production e
# recusam o boot com valor true. Fora de development o valor e ignorado.
# ADMIN_MFA_DEV_BYPASS=false

# STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EMAIL (Resend)
RESEND_API_KEY=
EMAIL_FROM=Corgly <no-reply@corgly.app>
# EMAIL_OVERRIDE=

# WEBRTC (TURN)
TURN_SERVER_URL=
TURN_SERVER_SECRET=

# SEO (Site Verification)
# Get tokens from Google Search Console and Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ERROR TRACKING (Sentry) — opcional, mas recomendado em produção
# Apos `npm i @sentry/nextjs`, configure:
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/yyy
# SENTRY_ORG=corgly
# SENTRY_PROJECT=corgly-web
# SENTRY_AUTH_TOKEN=           # gerado em Sentry → Settings → Auth Tokens
# SENTRY_ENVIRONMENT=production

# SEGURANCA — Secrets adicionais (gere com: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
SESSION_ENTRY_TOKEN_SECRET=gere-com-secrets-token-urlsafe-32
ASSET_URL_SIGNING_SECRET=gere-com-secrets-token-urlsafe-32
INTERNAL_TOKEN=gere-com-secrets-token-urlsafe-32

# CLOUDFLARE TURNSTILE (captcha do formulario publico) — opcional
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# STRIPE — Price IDs (crie Products/Prices no dashboard, 1 por oferta x moeda)
STRIPE_PRICE_MONTHLY10_BRL=
STRIPE_PRICE_MONTHLY10_EUR=
STRIPE_PRICE_MONTHLY10_USD=
STRIPE_PRICE_MONTHLY10_USDC=
STRIPE_PRICE_MONTHLY20_BRL=
STRIPE_PRICE_MONTHLY20_EUR=
STRIPE_PRICE_MONTHLY20_USD=
STRIPE_PRICE_MONTHLY20_USDC=
STRIPE_PRICE_PACK5_BRL=
STRIPE_PRICE_PACK5_EUR=
STRIPE_PRICE_PACK5_USD=
STRIPE_PRICE_PACK5_USDC=
STRIPE_PRICE_PACK10_BRL=
STRIPE_PRICE_PACK10_EUR=
STRIPE_PRICE_PACK10_USD=
STRIPE_PRICE_PACK10_USDC=
STRIPE_PRICE_SINGLE_BRL=
STRIPE_PRICE_SINGLE_EUR=
STRIPE_PRICE_SINGLE_USD=
STRIPE_PRICE_SINGLE_USDC=
STRIPE_PRICE_PROMO_BRL=
STRIPE_PRICE_PROMO_EUR=
STRIPE_PRICE_PROMO_USD=
STRIPE_PRICE_PROMO_USDC=

# RUNTIME — Flags e parametros operacionais
JOB=
MAINTENANCE_MODE=false
DEBUG_SQL=false
HOCUSPOCUS_PORT=1234
DATABASE_URL_TEST=mysql://user:password@localhost:3306/corgly_test
BILLING_IDEMPOTENCY_TTL_MS=
BOOKING_IDEMPOTENCY_TTL_MS=
BOOKING_LOCK_TTL_MS=
REALTIME_WS_ENABLED=true
NEXT_PUBLIC_REALTIME_WS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# RECIBOS — Dados da empresa emissora
RECEIPT_COMPANY_NAME=
RECEIPT_COMPANY_TAX_ID=
RECEIPT_COMPANY_ADDRESS=
RECEIPT_COMPANY_EMAIL=

# GOOGLE CALENDAR — agenda do professor (bloqueio de horario ocupado)
# Google Cloud Console > Credentials > API key, com "Google Calendar API" habilitada.
# Leitura apenas; calendario privado exige OAuth (client id/secret + refresh token).
GOOGLE_CALENDAR_API_KEY=

# GOOGLE CALENDAR — OAuth 2.0 (leitura da agenda do professor)
# Google Cloud Console > Google Auth Platform > Clients > Create client (Web application).
# Escopos: calendar.readonly + userinfo.email + openid. Redirect URI deve bater com a
# registrada no client. Nunca comitar o secret.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3110/api/v1/google-calendar/callback

# Token TXT de verificacao do dominio no Google Search Console (propriedade Domain).
GOOGLE_SITE_VERIFICATION_CORGLY_APP=
